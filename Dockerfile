# syntax=docker/dockerfile:1
#
# Haven — multi-stage Docker build
#
#   deps     -> installs ALL npm packages (cached unless package*.json change)
#   builder  -> runs `prisma generate` + `next build` (produces .next/standalone)
#   migrator -> tiny job image that runs `prisma migrate deploy` (used by compose)
#   runner   -> slim production image: only the standalone server, no dev deps,
#               no source code, no secrets
#
# Secrets (.env) are NEVER copied into any stage: .dockerignore excludes them
# and docker-compose injects them at *run* time via env_file.

ARG NODE_VERSION=22-alpine

# ───────────────────────────── 1. deps ─────────────────────────────
FROM node:${NODE_VERSION} AS deps
WORKDIR /app
# Copy only the manifests first. Docker caches each layer, so as long as
# package.json / package-lock.json don't change, `npm ci` is skipped on rebuilds.
COPY package.json package-lock.json ./
# `npm ci` = clean, reproducible install exactly matching the lockfile.
RUN npm ci

# ───────────────────────────── 2. builder ──────────────────────────
FROM node:${NODE_VERSION} AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Prisma 7 generates a TypeScript client into app/generated/prisma (see
# schema.prisma `output`). Because it lives inside the app folder, Next.js'
# file tracing bundles it into .next/standalone automatically.
# `generate` does not connect to a database, so a placeholder URL is enough.
ENV DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"
RUN npx prisma generate

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ───────────────────────────── 3. migrator ─────────────────────────
# A one-shot container: apply pending migrations, then exit.
# It reuses the full node_modules (Prisma CLI lives there) but is never shipped
# as the web server.
FROM deps AS migrator
WORKDIR /app
COPY prisma ./prisma
COPY prisma.config.ts ./
CMD ["npx", "prisma", "migrate", "deploy"]

# ───────────────────────────── 4. runner ───────────────────────────
FROM node:${NODE_VERSION} AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Don't run as root inside the container (security best practice).
RUN addgroup -S -g 1001 nodejs && adduser -S -u 1001 -G nodejs nextjs

# public/ assets and the static JS/CSS chunks are NOT inside standalone,
# so they must be copied next to it explicitly.
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000

# server.js is generated by Next's standalone output — no `next start`,
# no full node_modules needed.
CMD ["node", "server.js"]
