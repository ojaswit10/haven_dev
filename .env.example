# Copy this file to `.env` and fill in real values. `.env` is git-ignored
# and docker-ignored — it is only read at RUN time by docker-compose (env_file).

# Used by `npm run dev` on your machine (e.g. Neon). Inside Docker this is
# overridden by docker-compose to point at the `db` container.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

GROQ_API_KEY=""
NEXTAUTH_SECRET=""          # generate with: npx auth secret
NEXTAUTH_URL="http://localhost:3000"
RESEND_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — override the local Docker Postgres credentials (defaults shown)
# POSTGRES_USER=haven
# POSTGRES_PASSWORD=haven_local_pw
# POSTGRES_DB=haven
