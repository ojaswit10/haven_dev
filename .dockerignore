# Everything listed here is NOT sent to Docker as "build context".
# Smaller context = faster builds, and secrets can never leak into an image.

# Dependencies & build output (rebuilt inside the image, for Linux)
node_modules
.next
out
build

# Prisma client is regenerated inside the image by `prisma generate`
app/generated

# Secrets — injected at runtime by docker-compose, never baked in
.env
.env.*
!.env.example

# Git & editor/tooling noise
.git
.gitignore
.claude
.vscode
*.log
errors.txt
*.tsbuildinfo
next-env.d.ts

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml

# Docs
*.md
